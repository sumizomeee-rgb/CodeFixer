[Unit]
Description=CodeFixer Repair Control Tower
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/codefixer
Environment=CODEFIXER_ENV=production
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/codefixer/backend/.venv/bin/python -m codefixer
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=control-group

[Install]
WantedBy=default.target
