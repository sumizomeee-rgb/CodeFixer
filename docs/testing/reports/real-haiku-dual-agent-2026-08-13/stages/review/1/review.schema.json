{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeFixer review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "input_sha256", "verdict", "summary", "issues"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mode": {"type": "string", "enum": ["change", "no_change"]},
    "input_sha256": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["approved", "needs_repair", "rejected"]},
    "summary": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary", "evidence_ids"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocking", "warning"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
