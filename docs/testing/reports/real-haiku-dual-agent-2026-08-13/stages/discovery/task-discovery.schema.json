{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeFixer task-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "source", "summary", "candidate_scope", "evidence", "failure"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "decision": {"type": "string", "enum": ["located", "no_change_claim", "unresolved"]},
    "source": {"$ref": "#/$defs/source"},
    "summary": {"type": "string", "minLength": 1},
    "candidate_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "summary", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "location", "revision", "locator", "summary", "content_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["source", "history", "ticket", "attachment", "verification"]}, "location": {"type": "string", "minLength": 1}, "revision": {"type": ["string", "null"]}, "locator": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "content_sha256": {"type": ["string", "null"]}}}
  }
}
