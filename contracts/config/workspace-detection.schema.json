{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefixer.local/contracts/config/workspace-detection.schema.json",
  "type": "object",
  "required": ["path", "ready", "vcsKind", "hostingKind", "summary", "checks"],
  "properties": {
    "path": {"type": "string"},
    "ready": {"type": "boolean"},
    "vcsKind": {"enum": ["git", "svn", "unknown"]},
    "hostingKind": {"enum": ["gitlab", "github", "other", "none", "ambiguous"]},
    "repositoryRoot": {"type": "string", "minLength": 1},
    "remoteUrl": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["ready", "warning", "failed"]},
          "summary": {"type": "string", "minLength": 1},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
