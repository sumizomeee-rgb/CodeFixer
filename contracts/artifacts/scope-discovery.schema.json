{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeFixer scope-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome", "source", "summary", "candidate_scope", "search_entry_points", "limitations", "failure"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "outcome": {"type": "string", "enum": ["candidates", "unresolved"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "candidate_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "search_entry_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "summary", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
