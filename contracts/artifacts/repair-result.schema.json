{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeFixer repair result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome", "summary", "changed_paths_claimed", "checks_requested", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "outcome": {"enum": ["changed", "no_valid_diff", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "changed_paths_claimed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "checks_requested": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
