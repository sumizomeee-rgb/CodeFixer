{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeFixer frozen delivery metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conventional_type", "technology_tag", "ticket_key", "module_name", "change_summary", "submitter_name", "commit_subject", "patch_filename"],
  "properties": {
    "schema_version": {"const": 1},
    "conventional_type": {"enum": ["fix", "feat"]},
    "technology_tag": {"type": "string", "minLength": 1, "maxLength": 40},
    "ticket_key": {"type": "string", "minLength": 1, "maxLength": 80},
    "branch_label": {"type": "string", "minLength": 1, "maxLength": 40, "deprecated": true},
    "version_label": {"type": "string", "minLength": 1, "maxLength": 40},
    "module_name": {"type": "string", "minLength": 1, "maxLength": 40},
    "change_summary": {"type": "string", "minLength": 1, "maxLength": 80},
    "submitter_name": {"type": "string", "minLength": 1, "maxLength": 60},
    "commit_subject": {"type": "string", "minLength": 1, "maxLength": 500},
    "patch_filename": {"type": "string", "minLength": 7, "maxLength": 240, "pattern": "\\.patch$"}
  }
}
